HOST=127.0.0.1
PORT=7676
# This file is a reference only. DevSpace does not automatically load `.env`.
# Set environment variables in the process/service environment when you use them.
# Owner password generated by the repository-local `init` command in the current user's
# .devspace\auth.json. Set this only for non-interactive or fully env-driven
# deployments.
# DEVSPACE_OAUTH_OWNER_TOKEN=change-me-to-a-long-random-secret
# Optional OAuth tuning.
# DEVSPACE_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# DEVSPACE_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# DEVSPACE_OAUTH_SCOPES=devspace
# DEVSPACE_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1
# Windows example. Replace these with directories you intentionally allow.
DEVSPACE_ALLOWED_ROOTS=C:\Users\<username>\Projects,C:\Work
# Optional. Leave unset for local-only operation. For remote HTTPS access,
# set the public origin without /mcp. DevSpace derives the inbound Host
# allowlist from this URL.
# DEVSPACE_PUBLIC_BASE_URL=https://your-public-host.example.com
# Advanced escape hatch. `*` disables Host header allowlist protection.
# DEVSPACE_ALLOWED_HOSTS=localhost,127.0.0.1,your-public-host.example.com
# This distribution uses the Codex tool surface by default and does not expose
# minimal/full deployment modes.
# off | changes | full. Defaults to full.
# changes exposes the aggregate show_changes review flow.
# DEVSPACE_WIDGETS=full
DEVSPACE_LOG_LEVEL=info
DEVSPACE_LOG_FORMAT=json
DEVSPACE_LOG_REQUESTS=1
DEVSPACE_LOG_ASSETS=0
DEVSPACE_LOG_TOOL_CALLS=1
DEVSPACE_LOG_SHELL_COMMANDS=0
# DEVSPACE_TRUST_PROXY=1
# DEVSPACE_STATE_DIR=C:\Users\<username>\.devspace\state
# DEVSPACE_WORKTREE_ROOT=C:\Users\<username>\.devspace\worktrees
# Native-file download is opt-in. Files stream to a model-selected relative
# path inside an already-open workspace without overwriting existing files.
# DEVSPACE_ARTIFACTS=1
# DEVSPACE_ARTIFACT_MAX_FILE_BYTES=104857600
# Skills are enabled by default. Set DEVSPACE_SKILLS=0 to hide them.
# DEVSPACE_SKILLS=0
# DEVSPACE_AGENT_DIR=C:\Users\<username>\.codex
# DEVSPACE_SKILL_PATHS=C:\Users\<username>\.codex\skills,C:\Users\<username>\.agents\skills
